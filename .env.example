# Copy this file to .env and fill in the values before running locally.

# ─── Supabase (database + auth + image storage) ────────────────────────────
# Supabase Dashboard → Project Settings → API
# One-time backend setup: run supabase/schema.sql in the SQL Editor, create the
# `products` and `gallery` storage buckets (public read, authenticated write),
# and add one admin user under Authentication → Users.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Email (Resend, via the /api/send serverless function) ─────────────────
# These are SERVER-side only — no VITE_ prefix, never exposed to the browser.
# Set them in Vercel → Project → Settings → Environment Variables.
#   RESEND_API_KEY     → https://resend.com/api-keys
#   CONTACT_TO_EMAIL   → inbox that receives leads (e.g. bogotmaster@gmail.com)
#   CONTACT_FROM_EMAIL → verified sender on your Resend domain
#                        e.g. "Bogot Master <noreply@bogotmaster.org>"
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
