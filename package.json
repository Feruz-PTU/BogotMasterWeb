{
    "name": "bogotmaster-website",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "content": "node scripts/fetch-content.mjs && node scripts/build-media.mjs",
        "dev": "npm run content && vite",
        "build:client": "vite build",
        "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
        "build": "npm run content && node scripts/content-guard.mjs && npm run build:client && npm run build:server && node scripts/prerender.mjs",
        "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
        "preview": "vite preview",
        "images": "node scripts/optimize-images.mjs",
        "verify": "node scripts/verify-build.mjs"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.104.1",
        "lucide-react": "^1.17.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-helmet-async": "^2.0.5",
        "react-router-dom": "^7.14.2",
        "resend": "^6.14.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "eslint-plugin-react-refresh": "^0.4.6",
        "sharp": "^0.34.5",
        "vite": "^8.0.10"
    }
}
